{
  "name": "@example/basics",
  "type": "module",
  "version": "1.0.2-beta",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4325",
    "build": "rimraf .apphosting && astro build",
    "start": "node --input-type=module -e \"process.env.HOST='0.0.0.0'; import('./dist/server/entry.mjs').then(({ startServer }) => startServer())\"",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/vue": "^7.0.2",
    "@heroicons/react": "^2.2.0",
    "@nanostores/vue": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "astrojs-service-worker": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "nanoid": "^6.0.1",
    "nanostores": "^1.5.3",
    "nodemailer": "^10.0.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "jsdom": "^30.0.1",
    "rimraf": "^6.1.3",
    "vitest": "^5.0.0"
  }
}
