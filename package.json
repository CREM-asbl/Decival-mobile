{
  "name": "@example/basics",
  "type": "module",
  "version": "1.0.2-beta",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4325",
    "build": "rimraf .apphosting && astro build",
    "start": "node --input-type=module -e \"process.env.HOST='0.0.0.0'; import('./dist/server/entry.mjs').then(({ startServer }) => startServer())\"",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "check": "astro check",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.8",
    "@astrojs/vue": "^7.1.0",
    "@heroicons/react": "^2.2.0",
    "@nanostores/vue": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "astrojs-service-worker": "^2.0.3",
    "canvas-confetti": "^1.9.4",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "nanoid": "^6.0.2",
    "nanostores": "^1.5.5",
    "nodemailer": "^10.1.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "firebase-tools": "^15.34.0",
    "jsdom": "^30.1.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
