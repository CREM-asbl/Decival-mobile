{
  "name": "@example/basics",
  "type": "module",
  "version": "1.0.2-beta",
  "private": true,
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4325",
    "build": "rimraf .apphosting && astro build",
    "start": "node --input-type=module -e \"process.env.HOST='0.0.0.0'; import('./dist/server/entry.mjs').then(({ startServer }) => startServer())\"",
    "preview": "astro preview --host 0.0.0.0",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.2",
    "@astrojs/vue": "^7.0.2",
    "@heroicons/react": "^2.2.0",
    "@nanostores/vue": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.2",
    "astrojs-service-worker": "^2.0.2",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "nanoid": "^5.1.16",
    "nanostores": "^1.5.0",
    "nodemailer": "^8.0.11",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@types/canvas-confetti": "^1.9.0",
    "jsdom": "^29.1.1",
    "rimraf": "^6.1.3",
    "vitest": "^4.1.10"
  }
}
