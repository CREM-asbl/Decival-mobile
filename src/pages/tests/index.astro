---
import Button from "../../components/common/Button.astro";
import Layout from "../../layouts/Layout.astro";
import { OPERATION_ICONS } from "../../stores/badgeStore";
import { ICON_PATHS } from "../../config/icons";

const testTypes = [
  {
    id: "comparison",
    title: "Comparaisons",
    description: "Comparer des nombres",
    icon: OPERATION_ICONS.comparison,
    href: "/tests/comparison",
  },
  {
    id: "addition",
    title: "Additions",
    description: "Pratiquer les additions",
    icon: OPERATION_ICONS.addition,
    href: "/tests/addition",
  },
  {
    id: "subtraction",
    title: "Soustractions",
    description: "Pratiquer les soustractions",
    icon: OPERATION_ICONS.subtraction,
    href: "/tests/subtraction",
  },
  {
    id: "multiplication",
    title: "Multiplications",
    description: "Pratiquer les multiplications",
    icon: OPERATION_ICONS.multiplication,
    href: "/tests/multiplication",
  },
] as const;
---

<Layout title="Tests - Decival" currentPage="tests">
  <div class="max-w-lg mx-auto py-6 px-4">
    <h1 class="text-2xl font-bold mb-6">Choisis ton exercice</h1>

    <div class="space-y-4">
      {
        testTypes.map((test) => (
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 border border-transparent dark:border-gray-700">
            <div class="flex items-center gap-4 mb-4">
              <svg
                class="shrink-0 w-10 h-10"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  d={ICON_PATHS[test.icon]}
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                />
              </svg>
              <h2 class="text-xl font-semibold dark:text-white">
                {test.title}
              </h2>
              <span class="sr-only">{test.description}</span>
            </div>
            <div class="flex justify-end">
              <a href={test.href} class="no-underline">
                <Button variant="primary" size="md" type="link">
                  Commencer
                </Button>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
