---
import Layout from "../../layouts/Layout.astro";
import { OPERATION_ICONS } from "../../stores/badgeStore";

const testTypes = [
  {
    id: "comparison",
    title: "Comparaisons",
    description: "Comparer des nombres",
    hint: "Range des nombres du plus petit au plus grand",
    icon: OPERATION_ICONS.comparison,
    href: "/tests/mode?op=comparison",
  },
  {
    id: "addition",
    title: "Additions",
    description: "Pratiquer les additions",
    hint: "Additionne avec et sans virgule",
    icon: OPERATION_ICONS.addition,
    href: "/tests/mode?op=addition",
  },
  {
    id: "subtraction",
    title: "Soustractions",
    description: "Pratiquer les soustractions",
    hint: "Soustrais en alignant bien les chiffres",
    icon: OPERATION_ICONS.subtraction,
    href: "/tests/mode?op=subtraction",
  },
  {
    id: "multiplication",
    title: "Multiplications",
    description: "Pratiquer les multiplications",
    hint: "Multiplie et place la virgule au bon endroit",
    icon: OPERATION_ICONS.multiplication,
    href: "/tests/mode?op=multiplication",
  },
] as const;
---

<Layout title="Tests - Decival" currentPage="tests">
  <div class="max-w-lg mx-auto py-6 px-4">
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">
      Étape 2 sur 3 — Exercice
    </p>
    <h1 class="text-2xl font-bold mb-1">Choisis ton exercice</h1>
    <p class="text-sm text-gray-600 dark:text-gray-300 mb-6">
      <span data-student-current></span>
      <a href="/tests/qui" class="underline underline-offset-2 ml-1">Changer d'élève</a>
    </p>
    <p id="tests-help" class="text-sm text-gray-600 dark:text-gray-300 mb-4">
      Étape 2 sur 3. Choisis un exercice, puis un mode. Ton historique et ta maîtrise sont sauvegardés pour ton profil.
    </p>

    <div class="space-y-4">
      {
        testTypes.map((test) => (
          <div data-category={test.id} class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 border border-transparent dark:border-gray-700">
            <div class="flex items-center gap-4 mb-1">
              <span
                class="shrink-0 text-4xl leading-none"
                aria-hidden="true"
              >
                {test.icon}
              </span>
              <div>
                <h2 class="text-xl font-semibold dark:text-white">
                  {test.title}
                </h2>
                <p class="text-sm text-gray-700 dark:text-gray-300">
                  {test.hint}
                </p>
                <p data-meta class="text-xs text-gray-500 dark:text-gray-400 mt-1"></p>
              </div>
              <span class="sr-only">{test.description}</span>
            </div>
            <div class="flex justify-end">
              <a data-cta href={test.href} class="no-underline relative inline-flex items-center justify-center font-medium rounded-md px-4 py-2.5 min-h-[44px] text-base text-white bg-accent hover:bg-accent-hover focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent transition-all duration-300 ease-out">
                Commencer
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  import { getActiveStudent } from "../../stores/studentStore";
  import { testHistory } from "../../stores/testStore";
  import { typeMastery } from "../../stores/typeMasteryStore";
  import { getCategorySummary } from "../../logic/progressLogic";
  import { buildModeUrl } from "../../utils/testModeRoute";

  const current = document.querySelector("[data-student-current]");

  function renderStudent() {
    const active = getActiveStudent();
    if (!active) {
      window.location.replace("/tests/qui");
      return;
    }
    if (current) current.textContent = `Session : ${active.name} ·`;
  }

  function renderHubMeta() {
    const history = testHistory.get();
    const mastery = typeMastery.get().mastery ?? {};
    document.querySelectorAll<HTMLElement>("[data-category]").forEach((card) => {
      const category = card.dataset.category ?? "";
      const s = getCategorySummary(category, history, mastery);
      const meta = card.querySelector("[data-meta]");
      const cta = card.querySelector("[data-cta]");
      if (cta && cta instanceof HTMLAnchorElement) cta.href = buildModeUrl(category);
      if (meta) {
        meta.textContent =
          s.testCount === 0
            ? "Aucun test pour l'instant"
            : `Moyenne ${s.averageScore}% · ${s.testCount} test${s.testCount > 1 ? "s" : ""} · ${s.masteredCount}/${s.totalTypes} maîtrisées${s.integerMastered ? " · entiers ✓" : ""}`;
      }
      if (cta) cta.textContent = s.testCount === 0 ? "Commencer" : "Continuer";
      if (s.testCount > 0 && s.masteredCount < s.totalTypes) {
        card.dataset.recommended = "true";
        card.classList.add("ring-2", "ring-accent", "ring-offset-2");
      }
    });
  }

  renderStudent();
  renderHubMeta();
</script>
