---
import Layout from "../../../layouts/Layout.astro";
---

<Layout title="Qui joue ? - Decival" currentPage="tests">
  <div class="max-w-lg mx-auto py-6 px-4">
    <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-1">
      Étape 1 sur 3 — Qui joue
    </p>
    <h1 class="text-2xl font-bold mb-6">Qui joue ?</h1>

    <section
      aria-label="Qui joue ?"
      class="mb-4 rounded-lg border border-transparent bg-white p-4 shadow dark:border-gray-700 dark:bg-gray-800"
    >
      <p data-student-current class="text-sm text-gray-600 dark:text-gray-300 mb-2"></p>
      <div data-student-list class="flex flex-wrap gap-2 mb-3"></div>
      <form data-student-form class="flex gap-2">
        <label class="sr-only" for="student-name">Prénom de l'élève</label>
        <input
          id="student-name"
          name="name"
          type="text"
          maxlength="20"
          autocomplete="off"
          placeholder="Prénom (ex. Pierre)"
          class="min-w-0 flex-1 rounded-md border border-gray-300 px-3 py-2 text-base dark:border-gray-600 dark:bg-gray-700 dark:text-white"
        />
        <button
          type="submit"
          class="shrink-0 inline-flex items-center justify-center font-medium rounded-md px-4 py-2 min-h-[44px] text-white bg-accent hover:bg-accent-hover focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent"
        >
          Ajouter
        </button>
      </form>
      <p data-student-error role="alert" class="hidden text-sm text-red-600 mt-2"></p>
    </section>

    <a
      data-cta
      href="/tests"
      class="no-underline relative inline-flex items-center justify-center font-medium rounded-md px-6 py-3 text-lg text-white bg-accent hover:bg-accent-hover focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent transition-all duration-300 ease-out"
    >
      Choisir mon exercice
    </a>
  </div>

</Layout>

<script>
  import { addStudent, getActiveStudent, getStudents, setActiveStudent, validateStudentName } from "../../../stores/studentStore";

  const list = document.querySelector("[data-student-list]");
  const current = document.querySelector("[data-student-current]");
  const form = document.querySelector<HTMLFormElement>("[data-student-form]");
  const input = document.getElementById("student-name") as HTMLInputElement | null;
  const error = document.querySelector("[data-student-error]");
  const cta = document.querySelector<HTMLAnchorElement>("[data-cta]");

  function showError(message: string) {
    if (!error) return;
    error.textContent = message;
    error.classList.remove("hidden");
  }

  function clearError() {
    if (!error) return;
    error.textContent = "";
    error.classList.add("hidden");
  }

  function render() {
    const students = getStudents();
    const active = getActiveStudent();
    if (current) {
      current.textContent = active
        ? `Session : ${active.name}`
        : students.length === 0
          ? "Crée ton prénom pour commencer."
          : "Choisis ton prénom.";
    }
    if (cta) {
      const ready = active !== null;
      cta.classList.toggle("hidden", !ready);
      cta.setAttribute("aria-disabled", String(!ready));
    }
    if (list) {
      list.innerHTML = "";
      for (const s of students) {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.textContent = s.name;
        btn.setAttribute("aria-pressed", String(active?.id === s.id));
        btn.className =
          "px-4 py-2 min-h-[44px] rounded-full text-sm font-medium transition-colors " +
          (active?.id === s.id
            ? "bg-accent text-white"
            : "bg-gray-100 text-gray-800 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600");
        btn.addEventListener("click", () => {
          clearError();
          setActiveStudent(s.id);
          render();
        });
        list.appendChild(btn);
      }
    }
  }

  function createStudent(name: string) {
    try {
      addStudent(name);
      if (input) input.value = "";
      render();
    } catch (err) {
      showError(err instanceof Error ? err.message : "Prénom invalide");
    }
  }

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    clearError();
    const name = input?.value ?? "";
    let cleanName: string;
    try {
      cleanName = validateStudentName(name);
    } catch (err) {
      showError(err instanceof Error ? err.message : "Prénom invalide");
      return;
    }
    createStudent(cleanName);
  });

  render();
</script>
