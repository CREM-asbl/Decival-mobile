---
import Icon from "../components/common/Icon.astro";
import MrComma from "../components/vue/MrComma.vue";
import Layout from "../layouts/Layout.astro";

const features = [
  {
    icon: "clipboard",
    title: "Évaluations diagnostiques",
    description:
      "Évalue les acquis des élèves et identifie les notions à consolider",
  },
  {
    icon: "chart",
    title: "Diagnostic pour l'enseignant",
    description: "Repère les erreurs fréquentes et les besoins d'accompagnement",
  },
  {
    icon: "book",
    title: "Lecture pédagogique des résultats",
    description: "Interprète les diagnostics pour ajuster les activités en classe",
  },
];
---

<Layout title="Decival - Évaluation et diagnostic des décimaux" currentPage="home">
  <div class="max-w-lg mx-auto px-4 py-8">
    <div class="text-center mb-6">
      <h1 class="text-3xl font-bold mb-4">Decival, au service du diagnostic pédagogique</h1>
      <p class="text-gray-700 dark:text-gray-300 mb-2">
        Élève ? Entraîne-toi sur les décimaux avec des exercices adaptés.
      </p>
      <p class="text-gray-700 dark:text-gray-300 mb-6">
        Enseignant ? Obtiens un diagnostic clair pour comprendre les erreurs et orienter la remédiation.
      </p>
      <div class="flex flex-col items-center justify-center">
        <div class="mb-4">
          <MrComma
            variant="pointing"
              level={1}
              animate={true}
              altText="Monsieur Virgule vous souhaite la bienvenue"
              client:load
            />
        </div>
        <section
          aria-label="Qui joue ?"
          class="w-full max-w-sm mb-4 rounded-2xl border border-gray-200 bg-white px-4 py-3 shadow-sm dark:border-gray-700 dark:bg-gray-800"
        >
          <h2 class="text-xl font-semibold mb-2 dark:text-white">Qui joue ?</h2>
          <p data-student-current class="text-sm text-gray-600 dark:text-gray-300 mb-2"></p>
          <div data-student-list class="flex flex-wrap gap-2 mb-3"></div>
          <form data-student-form class="flex gap-2">
            <label class="sr-only" for="student-name">Prénom de l'élève</label>
            <input
              id="student-name"
              name="name"
              type="text"
              maxlength="20"
              autocomplete="off"
              placeholder="Prénom (ex. Pierre)"
              class="min-w-0 flex-1 rounded-md border border-gray-300 px-3 py-2 text-base dark:border-gray-600 dark:bg-gray-700 dark:text-white"
            />
            <button
              type="submit"
              class="shrink-0 inline-flex items-center justify-center font-medium rounded-md px-4 py-2 min-h-[44px] text-white bg-accent hover:bg-accent-hover focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent"
            >
              Ajouter
            </button>
          </form>
          <p data-student-error role="alert" class="hidden text-sm text-red-600 mt-2"></p>
        </section>
        <a href="/tests" class="no-underline relative inline-flex items-center justify-center font-medium rounded-md px-6 py-3 text-lg text-white bg-accent hover:bg-accent-hover focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-accent transition-all duration-300 ease-out">Lancer l'évaluation diagnostique</a>
      </div>
    </div>

    <script>
      import { addStudent, getActiveStudent, getStudents, setActiveStudent } from "../stores/studentStore";
      import { migrateLegacyToStudent } from "../utils/persistence";

      const list = document.querySelector("[data-student-list]");
      const current = document.querySelector("[data-student-current]");
      const form = document.querySelector<HTMLFormElement>("[data-student-form]");
      const input = document.getElementById("student-name") as HTMLInputElement | null;
      const error = document.querySelector("[data-student-error]");

      function showError(message: string) {
        if (!error) return;
        error.textContent = message;
        error.classList.remove("hidden");
      }

      function clearError() {
        if (!error) return;
        error.textContent = "";
        error.classList.add("hidden");
      }

      function render() {
        const students = getStudents();
        const active = getActiveStudent();
        if (current) {
          current.textContent = active
            ? `Session : ${active.name}`
            : students.length === 0
              ? "Crée ton prénom pour commencer."
              : "Choisis ton prénom.";
        }
        if (list) {
          list.innerHTML = "";
          for (const s of students) {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.textContent = s.name;
            btn.setAttribute("aria-pressed", String(active?.id === s.id));
            btn.className =
              "px-4 py-2 min-h-[44px] rounded-full text-sm font-medium transition-colors " +
              (active?.id === s.id
                ? "bg-accent text-white"
                : "bg-gray-100 text-gray-800 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-100 dark:hover:bg-gray-600");
            btn.addEventListener("click", () => {
              clearError();
              setActiveStudent(s.id);
              render();
            });
            list.appendChild(btn);
          }
        }
      }

      form?.addEventListener("submit", (e) => {
        e.preventDefault();
        clearError();
        const name = input?.value ?? "";
        try {
          const isFirst = getStudents().length === 0;
          const student = addStudent(name);
          if (isFirst) migrateLegacyToStudent(student.id);
          if (input) input.value = "";
          render();
        } catch (err) {
          showError(err instanceof Error ? err.message : "Prénom invalide");
        }
      });

      render();
    </script>

    <section
      id="beta-note"
      class="mb-8 rounded-2xl border border-indigo-100 bg-indigo-50/80 px-4 py-2 shadow-sm dark:border-indigo-900 dark:bg-indigo-900/40"
    >
      <div class="flex items-center gap-3">
        <span
          class="inline-flex w-fit shrink-0 items-center gap-2 rounded-full bg-white/80 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-indigo-700 shadow-sm ring-1 ring-indigo-100 dark:bg-indigo-800/70 dark:text-indigo-100 dark:ring-indigo-700/60"
        >
          <span
            class="h-2 w-2 rounded-full bg-green-500 animate-pulse"
            aria-hidden="true"></span>
          Beta
        </span>
        <p class="flex-1 text-sm text-indigo-900/80 dark:text-indigo-100/80">
          Outil en évolution — merci de nous aider à l'améliorer.
        </p>
        <button
          type="button"
          data-dismiss-beta
          aria-label="Masquer le message beta"
          class="shrink-0 rounded-full min-w-11 min-h-11 flex items-center justify-center text-lg leading-none text-indigo-700 hover:bg-white/60 dark:text-indigo-100 dark:hover:bg-indigo-800"
        >
          ×
        </button>
      </div>
    </section>
    <script>
      const note = document.getElementById("beta-note");
      try {
        if (localStorage.getItem("decival-hide-beta") === "1" && note) {
          note.hidden = true;
        }
      } catch {}
      note
        ?.querySelector("[data-dismiss-beta]")
        ?.addEventListener("click", () => {
          if (note) note.hidden = true;
          try {
            localStorage.setItem("decival-hide-beta", "1");
          } catch {}
        });
    </script>

    <div class="grid gap-6 mt-12">
      {
        features.map((feature) => (
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 border border-transparent dark:border-gray-700">
            <div class="flex items-center mb-4">
              <Icon
                name={feature.icon as "clipboard" | "chart" | "book"}
                class="w-8 h-8 text-accent"
              />
              <h2 class="text-xl font-semibold ml-3 dark:text-white">
                {feature.title}
              </h2>
            </div>
            <p class="text-gray-600 dark:text-gray-400">
              {feature.description}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
