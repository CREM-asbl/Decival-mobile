---
interface Props {
  title: string;
  showBack?: boolean;
  backHref?: string;
  backLabel?: string;
}

const { title, showBack = true, backHref = "/tests", backLabel = "Retour à la liste des tests" } = Astro.props;
---

<nav
  class="sticky top-0 z-40 bg-white dark:bg-gray-800 shadow-sm dark:shadow-none border-b border-transparent dark:border-gray-700"
>
  <div class="container mx-auto px-4 py-3 flex items-center gap-4">
    {
      showBack && (
        <a
          href={backHref}
          class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors"
          aria-label={backLabel}
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"
            />
          </svg>
        </a>
      )
    }
    <h1 class="text-lg font-semibold text-gray-900 dark:text-white">{title}</h1>
  </div>
</nav>
