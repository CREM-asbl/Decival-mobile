---
import { ICON_PATHS, type IconName } from '../../config/icons';

export interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  fill="none"
  viewBox="0 0 24 24"
  stroke="currentColor"
  set:html={ICON_PATHS[name]}
/>
