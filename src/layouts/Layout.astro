---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import InstallPWA from "../components/InstallPWA.astro";
import { APP_VERSION } from "../config/constants";
import "../styles/global.css";

interface Props {
  title: string;
  currentPage?: string;
}

const { title, currentPage = "home" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- PWA tags -->
    <meta name="theme-color" content="#4f46e5" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Decival" />

    <!-- PWA manifest -->
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- Blocking script to prevent FOUC and handle theme persistence -->
    <script is:inline>
      const theme = (() => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("darkMode")
        ) {
          return JSON.parse(localStorage.getItem("darkMode"))
            ? "dark"
            : "light";
        }
        if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
          return "dark";
        }
        return "light";
      })();

      const isDark = theme === "dark";
      document.documentElement.classList.toggle("dark", isDark);
      document.documentElement.style.colorScheme = isDark ? "dark" : "light";
    </script>
  </head>
  <body
    class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 min-h-screen pb-20"
  >
    <Header currentPage={currentPage} />

    <main class="mt-16">
      <slot />
    </main>

    <Footer currentPage={currentPage} />
    <InstallPWA />
    <script>
      import { APP_VERSION } from "../config/constants";
      import { initAnalytics } from "../firebase";

      // Initialisation de Firebase Analytics
      initAnalytics(APP_VERSION).catch(console.error);

      // Chargement des sons
      /*
       * Les sons sont synthétisés via Web Audio API (voir src/utils/soundEffects.ts)
       * donc pas de préchargement de fichiers nécessaire.
       */

      // Signalement automatique des erreurs JS non capturées (inspiré du POC Site-CREM)
      function fingerprintFor(err: Error | Event | string | null | undefined) {
              const message = err instanceof Error ? err.message : (err as any)?.message || String(err);
              const stack = err instanceof Error ? err.stack : (err as any)?.stack || '';
              const raw = (stack || message) +
                window.location.pathname + APP_VERSION + navigator.userAgent;
        let hash = 0;
        for (let i = 0; i < raw.length; i++) {
          hash = (hash * 31 + raw.charCodeAt(i)) | 0;
        }
        return Math.abs(hash).toString(36);
      }

      let reportInFlight = false;
      async function reportError(err: unknown, source: string) {
        if (reportInFlight) return;
        reportInFlight = true;
        const errObj = err instanceof Error ? err : new Error(String(err));
        try {
          const { actions } = await import('astro:actions');
          await actions.reportBug({
            message: errObj.message || String(err),
            stack: errObj.stack || "",
            page: window.location.pathname,
            appVersion: APP_VERSION,
            userAgent: navigator.userAgent,
            fingerprint: fingerprintFor(errObj),
            context: { source, href: window.location.href, referrer: document.referrer },
          });
        } catch {}
        finally { reportInFlight = false; }
      }

      window.addEventListener("error", (event: ErrorEvent) => {
        reportError(event.error || event.message, "window.onerror");
      });
      window.addEventListener("unhandledrejection", (event: PromiseRejectionEvent) => {
        reportError(event.reason, "unhandledrejection");
      });
    </script>
  </body>
</html>
